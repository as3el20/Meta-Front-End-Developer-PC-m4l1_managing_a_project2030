<div class="author">
    <h1 class="author_header">Hi, I am Aseel</h1>
    <p class="author_body">Web & Full Stack Developer </p>
</div>
<img class="hero-image" src="/imgs/hero-image.Webp" alt="Web Developer" width="581" height="528">
<section class="articles">
    <h2 class="articles_heading">Latest posts</h2>
    <ul class="article-ul">
        <% data.forEach(post => { %>
         
    
        <li>
            <a href="/post/<%= post._id %> ">
                <span><%= post.title %></span>
                <span class="article_list_date"><%= post.createdAt.toDateString() %></span>
            </a>
        </li>
        <% }) %>
    </ul>

    <% if (nextPage !== null) { %>
         <a href="/?page <%=nextPage %>" class="pagination">&lt; View Older Posts</a>
    <% } %>

    
</section>